BACKEND_ENV=development
DATABASE_URL=sqlite:///./cepa.db
STORAGE_DIR=./storage
WEIGHTS_DIR=./weights
ACTIVE_GRADING_POLICY=DEMO_ASSUMPTION_v1
LOG_LEVEL=INFO

# CV inference threading
CV_INFERENCE_WORKERS=2
CV_USE_GPU=false

# Report settings
REPORT_BASE_URL=http://localhost:8000
SHARE_LINK_BASE_URL=http://localhost:8000/api/v1/reports/share

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Model configuration
SEG_MODEL_PATH=./weights/yolo11n-seg.pt
SEG_CONFIDENCE_THRESHOLD=0.35
SEG_IOU_THRESHOLD=0.45
DEF_MODEL_PATH=./weights/defect_classifier.pt
DEF_USE_MOCK=true

# ChArUco calibration card physical dimensions (mm)
CHARUCO_SQUARE_LENGTH_MM=40.0
CHARUCO_MARKER_LENGTH_MM=20.0
CHARUCO_BOARD_SQUARES_X=7
CHARUCO_BOARD_SQUARES_Y=5

# Scale validation limits
SCALE_MIN_MM_PER_PX=0.05
SCALE_MAX_MM_PER_PX=5.0

# Quality gate thresholds
QG_BLUR_THRESHOLD=80.0
QG_DARK_THRESHOLD=40
QG_BRIGHT_THRESHOLD=215
QG_GLARE_FRACTION=0.05
QG_MIN_RESOLUTION_PX=1000
