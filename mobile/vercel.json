{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "framework": null,
  "build": {
    "env": {
      "EXPO_PUBLIC_API_URL": "https://cepa-backend.onrender.com"
    }
  },
  "env": {
    "EXPO_PUBLIC_API_URL": "https://cepa-backend.onrender.com"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
